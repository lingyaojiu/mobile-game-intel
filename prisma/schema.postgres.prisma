generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Entry {
  id        Int      @id @default(autoincrement())
  date      String   // YYYY-MM-DD
  category  String
  title     String
  content   String
  summary   String?  // 摘要
  source    String?
  imageUrl  String?  // 缩略图
  link      String?  // 原文链接
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
}
